rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMainAdmin() {
      return signedIn() &&
        request.auth.uid == "BDmAQWzHytWVucAsuy4JiCOlIgB2";
    }

    function isAdmin() {
      return isMainAdmin() ||
        (signedIn() &&
         exists(/databases/$(database)/documents/admin/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.role == "admin");
    }

    match /admin/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if isMainAdmin();
    }

    match /professores/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /planos/{planId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /solicitacoes_professoras/{uid} {
      allow create, update: if isOwner(uid);
      allow read: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /configuracoes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Dados pessoais do painel da professora. Cada registro pertence ao UID que o criou.
    match /agenda/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /frequencias/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /ocorrencias/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /alunos/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /diario/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /avaliacoes/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /materiais/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /eventos/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /bncc/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
